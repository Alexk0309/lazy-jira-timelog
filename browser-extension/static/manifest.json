{
  "manifest_version": 3,
  "name": "Lazy Jira Timelog",
  "short_name": "Timelog",
  "version": "0.1.0",
  "description": "Notices time on Jira-linked tabs and turns it into worklogs you confirm in one click.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Lazy Jira Timelog",
    "default_popup": "review.html?popup=1",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "idle", "notifications"],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://github.com/*",
    "https://gitlab.com/*",
    "https://bitbucket.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
